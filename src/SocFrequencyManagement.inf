[Version]
Signature="$Windows NT$"
Class=Processor
ClassGuid={50127dc3-0f36-415e-a6cc-4cb3be910b65}
Provider=%ProviderName%
DriverVer = 02/25/2026,18.7.41.622
CatalogFile = SocFrequencyManagement.cat
PnpLockdown = 1

[Manufacturer]
%MfgName%=Devices,NTARM64

[Devices.NTARM64]
%DeviceDesc% = SocFrequencyManagement_Install, Root\SocFrequencyManagement

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
SocFrequencyManagement.sys = 1,,

[DestinationDirs]
DefaultDestDir = 13

[SocFrequencyManagement_Install.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
SocFrequencyManagement.sys

[SocFrequencyManagement_Install.NT.Services]
AddService = SocFrequencyManagement, %SPSVCINST_ASSOCSERVICE%, SocFrequencyManagement_Service_Inst

[SocFrequencyManagement_Service_Inst]
DisplayName    = %SocFrequencyManagement.SVCDESC%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\SocFrequencyManagement.sys

[Strings]
ProviderName="Qualcomm"
MfgName="Qualcomm"
DeviceDesc="Qualcomm Snapdragon 855 Domain2 Tuning Driver"
DiskName="Qualcomm Snapdragon 855 Domain2 Tuning Installation Disk"
SPSVCINST_ASSOCSERVICE = 0x00000002
SocFrequencyManagement.SVCDESC = "Qualcomm Snapdragon 855 Domain2 Tuning Service"
